# Where the dashboard looks for the API. Defaults to http://localhost:5001/api/v1.
#
# This was hardcoded in App.jsx, so a production build could only ever talk to
# localhost — including the bundle in dist/.
#
# Vite inlines VITE_* variables at BUILD time, not at run time: changing this
# after `npm run build` has no effect on an existing bundle.
VITE_API_URL=http://localhost:5001/api/v1

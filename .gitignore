# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
*.local
npm-debug.log*

# Environment
.env
.env.*
!.env.example

# Runtime state & generated data
backend/data/*.json
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/incidents/
!backend/data/.gitkeep

# Threat-intel feed cache. Fetched via `make feeds`, never committed: the data
# is dated, third-party, and FireHOL aggregates sources with their own terms.
# NOTE: this pattern needs the full path. A bare `data/feeds/` contains a
# mid-string slash, so git anchors it to the repository root and it does not
# match backend/data/feeds at all — which is exactly what happened here.
backend/data/feeds/*
!backend/data/feeds/.gitkeep

*.log
# The loghub 2k samples ARE committed (~1.3 MB): the repo has to be runnable and
# testable on a clean clone with no downloads, and the parsing-accuracy eval is
# the tripwire for a misconfigured Drain masking config. The full 1.5 GB HDFS_v1
# is fetched on demand and stays ignored.
!backend/data/samples/*.log
!backend/data/samples/*.csv

# ML artifacts — datasets are fetched via scripts/download_data.py,
# models are rebuilt via `make train`. Neither belongs in git.
data/raw/
data/processed/
data/feeds/
models/

# Benchmark datasets — fetched by `python -m datasets.download`, never committed
backend/data/datasets/
backend/data/drain/
# Trained models and the cached feature matrix — rebuilt by `python -m eval.benchmark`.
# Full paths, not bare `models/`: a pattern with no slash matches at any depth,
# but `data/processed/` has a mid-string slash and git anchors it to the
# repository root, so it would not have matched backend/data/processed at all.
backend/data/models/
backend/data/processed/

# Sample-dataset benchmark output. Kept out of the repo so a 2,200-block smoke
# run can never be mistaken for the published 575,061-block result.
docs/METRICS.sample.md
docs/metrics.sample.json
